# ==============================================
# Aqua Voice Uzbek — Muhit o'zgaruvchilari
# ==============================================

# --- STT Provayderi ---
# Variantlar: auto | mock | gemini | local_whisper | openai | mohirpool
STT_PROVIDER=auto
LOCAL_WHISPER_MODEL=turbo
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=float16

# --- LLM Provayderi ---
# Variantlar: auto | mock | gemini | openai
LLM_PROVIDER=auto

# --- Google Gemini (tavsiya etilgan past latency LLM) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- OpenAI (Whisper STT va/yoki GPT-4o-mini LLM) ---
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini

# --- Mohirpool / Mohir.ai STT API (O'zbek tili) ---
MOHIRPOOL_API_KEY=
MOHIRPOOL_STT_URL=https://mohir.ai/api/v1/stt

# --- Server & Pipeline ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
DEFAULT_LANGUAGE=uz
LLM_TIMEOUT_SECONDS=8.0
STT_TIMEOUT_SECONDS=15.0
